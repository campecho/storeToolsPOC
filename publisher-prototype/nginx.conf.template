server {
    # IPv4 only: the container platform routes over IPv4, and an IPv6 listener
    # crash-loops nginx in sandboxes without an IPv6 stack.
    listen       ${PORT};
    server_name  _;
    root   /usr/share/nginx/html;
    index  index.html;

    # hashed build assets: cache forever
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA fallback: the shell owns routing, so every unknown path is index.html
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
